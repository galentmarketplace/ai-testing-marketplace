# ---- Copy to .env and fill in. NEVER commit .env. ----

# LLM (required for real runs)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# ---- Access control (Phase 0.1) ----
# Every /api route requires a principal: a signed-in browser session (GitHub OAuth) or a bearer API token.
# Users mint personal tokens in the dashboard (Configuration → API tokens) for the VS Code extension / MCP.
ATM_API_TOKEN=          # optional bootstrap SERVICE token (admin) for headless deployments, CI, smoke tests
ATM_ADMIN_LOGINS=       # comma-separated GitHub logins that may see every tenant's runs/Configurations
ATM_DATA_DIR=           # where SQLite + the Fernet key live (default ./data); MUST be a persistent volume

# Modes
MOCK_LLM=0          # 1 = canned responses (no key, no cost); 0 = real Claude
REAL_RUNNER=1       # 1 = actually execute Playwright / k6 (needs the target app reachable)
MAX_RETRIES=3

# Public URL of THIS platform (needed for the GitHub OAuth callback behind a tunnel/ingress)
PUBLIC_URL=

# GitHub OAuth app (Settings ▸ Developer settings ▸ OAuth Apps) — callback: <PUBLIC_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional PAT fallback for repo access without OAuth
GITHUB_TOKEN=

# Jenkins CI agent (optional)
JENKINS_URL=
JENKINS_USER=
JENKINS_TOKEN=
JENKINS_UI_JOB=ui-automation

# Default app-under-test credentials (per-project Configurations override these)
BASE_URL=
APP_USER=
APP_PASS=

# Per-pod performance sampling (optional): path to a kubeconfig inside the container
KUBECONFIG=
